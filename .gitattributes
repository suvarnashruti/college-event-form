<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>College Event Registration</title>
</head>
<body>
    <header>
        <h1>College Event Registration</h1>
        <nav>
            <a href="#about">About Event</a> 
            <a href="#registration"> Register</a> 
            <a href="#faq"> FAQ</a> 
            <a href="#contact"> Contact</a>
        </nav>
    </header>
    <main>
        <section id="about">
            <h2>About the Event</h2>
            <figure>
                <img src="college-event.jpg"
                     alt="Students participating in a college technology event"
                     width="500">
                <figcaption>
                    Students participating in the Annual Tech Fest.
                </figcaption>
            </figure>
            <p>
                Welcome to our Annual College Tech Fest, featuring exciting
                competitions, workshops, and seminars for students from all
                departments.
            </p>
            <p>
                Event Date:
                <time datetime="2026-09-15">
                    September 15, 2026
                </time>
            </p>
        </section>
        <!-- Registration Form -->
        <section id="registration">
            <h2>Registration Form</h2>
            <form action="#" method="post">
                <p>
                    <label for="full-name">Full Name:</label><br>
                    <input type="text" id="full-name" name="fullName" required>
                </p>
                <p>
                    <label for="email-address">Email:</label><br>
                    <input type="email" id="email-address" name="email" required>
                </p>
                <p>
                    <label for="phone-number">Phone Number:</label><br>
                    <input type="tel" id="phone-number" name="phoneNumber">
                </p>
                <p>
                    <label for="dob">Date of Birth:</label><br>
                    <input type="date" id="dob" name="dateOfBirth">
                </p>
                <p>
                    <label for="branch-select">Branch / Department:</label><br>
                    <select id="branch-select" name="branch">
                        <option value="">-- Please choose an option --</option>
                        <option value="cse">Computer Science & Engineering</option>
                        <option value="ece">Electronics & Communication Engineering</option>
                        <option value="me">Mechanical Engineering</option>
                        <option value="ce">Civil Engineering</option>
                        <option value="ee">Electrical Engineering</option>
                    </select>
                </p>
                <fieldset>
                    <legend>Current Year</legend>
                    <input type="radio" id="year-1" name="academicYear" value="1st">
                    <label for="year-1">1st Year</label><br>
                    <input type="radio" id="year-2" name="academicYear" value="2nd">
                    <label for="year-2">2nd Year</label><br>
                    <input type="radio" id="year-3" name="academicYear" value="3rd">
                    <label for="year-3">3rd Year</label><br>
                    <input type="radio" id="year-4" name="academicYear" value="4th">
                    <label for="year-4">4th Year</label>
                </fieldset>
                <br>
                <fieldset>
                    <legend>Events to Attend</legend>
                    <input type="checkbox" id="event-hackathon" name="events" value="hackathon">
                    <label for="event-hackathon">Hackathon</label><br>
                    <input type="checkbox" id="event-robotics" name="events" value="robotics">
                    <label for="event-robotics">Robo Sumo</label><br>
                    <input type="checkbox" id="event-gaming" name="events" value="gaming">
                    <label for="event-gaming">LAN Gaming Arena</label><br>
                    <input type="checkbox" id="event-seminar" name="events" value="seminar">
                    <label for="event-seminar">AI & Future Tech Seminar</label>
                </fieldset>
                <p>
                    <label for="referral-source">
                        How did you hear about us?
                    </label><br>
                    <textarea id="referral-source"
                              name="referralSource"
                              rows="4"
                              cols="40"></textarea>
                </p>
                <p>
                    <input type="submit" value="Register Now">
                </p>
            </form>
        </section>
    </main>
    <!-- Sidebar FAQ -->
    <aside id="faq">
        <h2>Frequently Asked Questions</h2>
        <h3>Who can participate?</h3>
        <p>All college students are welcome to register.</p>
        <h3>Is there any registration fee?</h3>
        <p>No, participation is completely free.</p>
        <h3>Will certificates be provided?</h3>
        <p>Yes, participation certificates will be awarded.</p>
    </aside>
    <!-- Footer -->
    <footer id="contact">
        <h2>Contact Us</h2>
        <address>
            Email:
            <a href="mailto:events@college.edu">
                events@college.edu
            </a>
            <br>
            XYZ College of Engineering<br>
            Main Campus Road<br>
            Patna, Bihar, India
        </address>
        <p>&copy; 2026 XYZ College. All rights reserved.</p>
    </footer>

</body>
</html>
